# SPDX-License-Identifier: BSD-3-Clause
#
# pkg-config file of an installed lwext4. The prefix is derived from this
# file's own location (lib/pkgconfig), so a moved install tree still works.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: lwext4
Description: ext2/ext3/ext4 filesystem library for microcontrollers
URL: https://github.com/gkostka/lwext4
Version: @LWEXT4_PACKAGE_VERSION@
Libs: -L${libdir} -lblockdev -llwext4
Cflags: -I${includedir}/lwext4
